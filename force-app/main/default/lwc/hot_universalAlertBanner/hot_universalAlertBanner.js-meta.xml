<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>HOT - Universal alert banner</masterLabel>
    <description>Universal alert banner with info, warning and error variants.</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__FlowScreen</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property
                name="type"
                type="String"
                label="Banner Type"
                datasource="Info,Warning,Error"
                role="inputOnly"
                required="true"
                default="Info"
            />
            <property
                name="message"
                type="String"
                label="Message"
                role="inputOnly"
                required="true"
                default="Message"
            />
            <property
                name="assistiveText"
                type="String"
                label="Assistive text override"
                role="inputOnly"
            />
            <property
                name="closeButton"
                type="Boolean"
                label="Show close button"
                role="inputOnly"
                default="true"
            />
        </targetConfig>
        <targetConfig targets="lightning__RecordPage,lightning__AppPage,lightning__HomePage">
            <property
                name="type"
                type="String"
                label="Banner Type"
                datasource="Info,Warning,Error"
                required="true"
                default="Info"
            />
            <property
                name="message"
                type="String"
                label="Message"
                required="true"
                default="Message"
            />
            <property
                name="assistiveText"
                type="String"
                label="Assistive text override"
            />
            <property
                name="closeButton"
                type="Boolean"
                label="Show close button"
                default="true"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>