<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>HOT Text Area Flow With Counter</masterLabel>
    <description>Count characters in the text area</description>

    <targets>
        <target>lightning__FlowScreen</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">

            <property
                name="label"
                type="String"
                label="Label" />

            <property
                name="inputText"
                type="String"
                label="Default value"
                role="outputOnly" />

            <property
                name="required"
                type="Boolean"
                label="Require input before continuing"
                default="false" />

            <property
                name="maxCharacters"
                type="Integer"
                label="Max characters"
                default="255" />

        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>